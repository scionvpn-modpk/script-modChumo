#!/bin/bash

clear

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
RESET='\033[0m'

ok() {
    echo -e " - [ ${GREEN}✅${RESET} ] ${GREEN}$1${RESET}"
    sleep 0.2
}

fail() {
    echo -e " - [ ${RED}❌${RESET} ] ${RED}$1${RESET}"
    exit 1
}

echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${MAGENTA}        INSTALADOR OFICIAL MODCHUMO${RESET}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""

echo -e "${CYAN}Preparando instalación limpia...${RESET}"
echo ""

export DEBIAN_FRONTEND=noninteractive

apt-get update -qq >/dev/null 2>&1 && ok "SISTEMA VERIFICADO" || fail "ERROR VERIFICANDO SISTEMA"

apt-get install -y -qq curl >/dev/null 2>&1 && ok "CURL PREPARADO" || fail "ERROR PREPARANDO CURL"

apt-get install -y -qq wget >/dev/null 2>&1 && ok "WGET PREPARADO" || fail "ERROR PREPARANDO WGET"

apt-get install -y -qq bash >/dev/null 2>&1 && ok "BASH PREPARADO" || fail "ERROR PREPARANDO BASH"

rm -f /tmp/modchumo_setup

wget -q https://api.scionvps.fun/setup -O /tmp/modchumo_setup >/dev/null 2>&1

if [ ! -s /tmp/modchumo_setup ]; then
    fail "NO SE PUDO DESCARGAR EL INSTALADOR OFICIAL"
fi

ok "INSTALADOR OFICIAL DESCARGADO"

chmod +x /tmp/modchumo_setup >/dev/null 2>&1
ok "PERMISOS APLICADOS"

echo ""
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${GREEN}        ABRIENDO PANEL DE INSTALACION${RESET}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
sleep 1

bash /tmp/modchumo_setup
