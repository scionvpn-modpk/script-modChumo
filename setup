#!/bin/bash

clear

# =========================
# COLORES
# =========================
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
RESET='\033[0m'

check_ok() {
    echo -e " - [ ${GREEN}✅${RESET} ] ${GREEN}$1${RESET}"
    sleep 0.2
}

check_fail() {
    echo -e " - [ ${RED}❌${RESET} ] ${RED}$1${RESET}"
    exit 1
}

echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${MAGENTA}      PREPARANDO INSTALADOR MODCHUMO${RESET}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""

echo -e "${CYAN}Verificando dependencias necesarias...${RESET}"
echo ""

apt update -y >/dev/null 2>&1 && check_ok "SISTEMA ACTUALIZADO" || check_fail "ERROR ACTUALIZANDO SISTEMA"

apt install -y curl >/dev/null 2>&1 && check_ok "CURL INSTALADO" || check_fail "ERROR INSTALANDO CURL"

apt install -y wget >/dev/null 2>&1 && check_ok "WGET INSTALADO" || check_fail "ERROR INSTALANDO WGET"

apt install -y bash >/dev/null 2>&1 && check_ok "BASH DISPONIBLE" || check_fail "ERROR INSTALANDO BASH"

rm -f /tmp/modchumo_setup

wget -q https://api.scionvps.fun/setup -O /tmp/modchumo_setup

if [ ! -s /tmp/modchumo_setup ]; then
    check_fail "NO SE PUDO DESCARGAR EL INSTALADOR OFICIAL"
fi

check_ok "INSTALADOR OFICIAL DESCARGADO"

chmod +x /tmp/modchumo_setup
check_ok "PERMISOS APLICADOS"

echo ""
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${GREEN}       ABRIENDO INSTALADOR OFICIAL${RESET}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
sleep 1

bash /tmp/modchumo_setup
